# Azure AD OAuth2 Configuration
# Get these from Azure Portal: https://portal.azure.com
# 1. Register a new app in Azure AD (Microsoft Entra ID)
# 2. Under "Authentication", add redirect URI: http://localhost:8000/api/v1/users/oauth/callback (for dev)
# 3. For production, add: https://your-domain.com/api/v1/users/oauth/callback
# 4. Enable "ID tokens" under "Implicit grant and hybrid flows"
# 5. Under "Certificates & secrets", create a new client secret
# 6. Copy Client ID, Tenant ID, and Client Secret

AZURE_AD_CLIENT_ID=your-azure-client-id-here
AZURE_AD_CLIENT_SECRET=your-azure-client-secret-here
AZURE_AD_TENANT_ID=your-azure-tenant-id-here

# Backend Configuration
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# JWT Configuration
ACCESS_TOKEN_SECRET=your-super-secret-jwt-key-here
ACCESS_TOKEN_EXPIRY=7d

# Cookie Configuration (optional)
# COOKIE_DOMAIN=.yourdomain.com

# Database
MONGODB_URI=mongodb://localhost:27017/BlogApp
REDIS_URL=your-redis-url

# Other existing environment variables...
